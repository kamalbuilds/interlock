# Interlock reads these from the environment. Put real values in .env, which is gitignored.
# Never commit a token. Never put one in a Dockerfile.

# Grafana Cloud. Required: without it Interlock has nowhere to file a breach.
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Gemini through Vertex AI. Required: triage and repair review are model decisions.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.5-flash

# Optional. Path to the official mcp-grafana binary, if it is not on PATH or in GOPATH/bin.
# INTERLOCK_MCP_GRAFANA=/path/to/mcp-grafana

# Optional. A Grafana Cloud Access Policy token with metrics:write, which is NOT the
# same credential as the stack service account token above. When both are present,
# Interlock stores the measured series in Grafana Cloud Prometheus through the OTLP
# gateway instead of carrying it as inline panel data, and says so on the panel.
# INTERLOCK_OTLP_USER=
# INTERLOCK_OTLP_TOKEN=
